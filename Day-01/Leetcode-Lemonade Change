bool lemonadeChange(int* bills, int billsSize) {
    int arr[21] = {0};

    for (int i = 0; i < billsSize; i++) {

        if (bills[i] == 5) {
            arr[5]++;
        }
        else if (bills[i] == 10) {
            if (arr[5] > 0) {
                arr[5]--;
                arr[10]++;
            }
            else {
                return false;
            }
        }
        else {  

            if (arr[10] > 0 && arr[5] > 0) {
                arr[10]--;
                arr[5]--;
            }
            else if (arr[5] >= 3) {
                arr[5] -= 3;
            }
            else {
                return false;
            }
        }
    }

    return true;
}
